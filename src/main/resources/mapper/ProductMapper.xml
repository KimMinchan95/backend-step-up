<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="dev.training.back.product.mapper.ProductMapper">

    <select id="findAll" resultType="dev.training.back.product.model.Product">
        SELECT id, name, price, stock
        FROM products
        ORDER BY id
    </select>

    <select id="findById" resultType="dev.training.back.product.model.Product">
        SELECT id, name, price, stock
        FROM products
        WHERE id = #{id}
    </select>

</mapper>
